# Copy this file to .env and fill in your keys.

# Graph backend: "json" (default, no DB needed) or "neo4j"
GRAPH_BACKEND=json
INDUSTREAL_RESULTS_ROOT=../IndustReal_Pipeline/results

# Neo4j (only needed if GRAPH_BACKEND=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM providers (fill in whichever you have)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Voice providers
ELEVENLABS_API_KEY=

# Local model endpoints (defaults work if running locally)
OLLAMA_ENDPOINT=http://localhost:11434
LMSTUDIO_ENDPOINT=http://localhost:1234/v1

# Server
HOST=0.0.0.0
PORT=8000
