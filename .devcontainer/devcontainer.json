{
  "name": "XR Event Grounding",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8080, 8000],
  "portsAttributes": {
    "8080": { "label": "Frontend", "onAutoForward": "notify" },
    "8000": { "label": "Backend API", "onAutoForward": "notify" }
  },
  "postCreateCommand": "cd backend && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
